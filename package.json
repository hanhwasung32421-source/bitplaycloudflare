    "vue-router": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.0"
  }
}
